# Copy this file to .env for local development.
# In Docker/production, set these as real environment variables / secrets —
# do not bake a .env file into the image (see .dockerignore).

# development | test | production
NODE_ENV=development

# Network
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Milliseconds to wait for in-flight requests to finish on SIGTERM before
# forcing an exit.
SHUTDOWN_TIMEOUT_MS=10000

# --- Reserved for later phases (not used yet) --------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# REDIS_URL=
# LITES_API_KEY=
# FRONTEND_URL=http://localhost:5173
